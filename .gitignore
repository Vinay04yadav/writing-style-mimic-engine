# Python virtual environment
venv/
*/venv/
env/
*/env/
.env
*.env

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# IDE and OS specific files
.vscode/
.idea/
*.DS_Store
.ipynb_checkpoints/

# Data Files (Usually too large for Git)
# Add exceptions below if you have SMALL sample data files you WANT to track
data/raw/
data/processed/
data/processed_books/
# Example Exception (if you had a small sample):
# !data/processed/samples/

# Model Files (Definitely too large for Git)
models/
# Example Exception (if you just wanted to track tiny model config):
# !models/*/config.json

# Log files & temporary files
*.log
*.tmp
*.swp

# Weights & Biases local files (if used)
wandb/

# Private project change log (keep local; do not push to GitHub)
PROJECT_CHANGELOG.private.md

# Generated text and blinded human-evaluation data (keep local/private)
results/generation_baseline/generated_samples.csv
results/generation_baseline/human_eval_packet.csv
results/generation_baseline/human_eval_key.csv
results/generation_baseline/human_ratings_template.csv
results/generation_baseline/human_ratings_completed.csv
results/generation_baseline/human_rating_summary.csv

